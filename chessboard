N = 8
board = [-1] * N

def is_safe(row, col):
    for prev_col in range(col):
        prev_row = board[prev_col]

        if prev_row == row:
            return False

        if abs(prev_row - row) == abs(prev_col - col):
            return False

    return True

def solve_queens(col):
    if col == N:
        return True

    for row in range(N):
        if is_safe(row, col):
            board[col] = row

            if solve_queens(col + 1):
                return True

            board[col] = -1

    return False

if solve_queens(0):
    for row in range(N):
        for col in range(N):
            if board[col] == row:
                print("Q", end=" ")
            else:
                print(".", end=" ")
        print()
else:
    print("No solution")
